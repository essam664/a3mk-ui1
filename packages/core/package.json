{
  "name": "@a3mk-ui/core",
  "version": "1.0.0-a3mk-ui1",
  "description": "A3MK-UI Core — Framework-agnostic Glassmorphism component library",
  "type": "module",

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    },
    "./button": {
      "types": "./dist/components/button/a3mk-button.d.ts",
      "import": "./dist/components/button/a3mk-button.js",
      "require": "./dist/components/button/a3mk-button.cjs"
    },
    "./config": {
      "types": "./dist/config/a3mk.config.d.ts",
      "import": "./dist/config/a3mk.config.js",
      "require": "./dist/config/a3mk.config.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js",
      "require": "./dist/tokens/tokens.cjs"
    },
    "./styles": "./dist/styles.css",
    "./package.json": "./package.json"
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],

  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs"
  ],

  "scripts": {
    "dev": "vite build --watch --mode development",

    "build": "tsc --noEmit && vite build --mode production",
    "build:analyze": "vite build --mode analyze",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",

    "typecheck": "tsc --noEmit",

    "clean": "rimraf dist node_modules/.vite node_modules/.cache",
    "clean:dist": "rimraf dist",

    "prepublishOnly": "npm run clean:dist && npm run build && npm test",

    "prepack": "npm run build",

    "publish:dry": "npm publish --dry-run",

    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },

  "dependencies": {
    "lit": "^3.2.0"
  },

  "peerDependencies": {
    "@phosphor-icons/web": "^2.1.0"
  },

  "peerDependenciesMeta": {
    "@phosphor-icons/web": {
      "optional": true
    }
  },

  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/browser": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "terser": "^5.27.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  },

  "keywords": [
    "ui",
    "glassmorphism",
    "web-components",
    "lit",
    "a3mk",
    "framework-agnostic",
    "typescript",
    "rtl",
    "dark-mode",
    "light-mode",
    "accessibility",
    "a11y",
    "custom-elements",
    "design-system",
    "component-library"
  ],

  "author": {
    "name": "A3MK",
    "url": "https://github.com/a3mk"
  },

  "license": "MIT",

  "homepage": "https://a3mk-ui.dev",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/a3mk/ui.git",
    "directory": "packages/core"
  },

  "bugs": {
    "url": "https://github.com/a3mk/ui/issues"
  },

  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },

  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
